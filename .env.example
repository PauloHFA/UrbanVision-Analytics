# UrbanVision Analytics - Variáveis de Ambiente de Produção

# Configurações do Banco de Dados (PostgreSQL / PostGIS)
DATABASE_URL=postgresql+psycopg2://urbanvision:urbanvision_secret@localhost:5432/urbanvision_db

# Configurações da Aplicação
PROJECT_NAME="UrbanVision Analytics"
VERSION=1.0.0
API_V1_PREFIX=/v1

# Parâmetros de Calibração IDU (Seção 08 do PDF)
DEFAULT_S_REF=40.0
MIN_COVERAGE_PCT=60.0
MIN_L_OBS_KM=1.0
DEDUPLICATION_RADIUS_METERS=10.0
